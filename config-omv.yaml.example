# Configuration for OMV (Home NAS) Backup
# Connects to localhost (127.0.0.1) via SSH to run backup commands on itself

ssh:
  host: "127.0.0.1"
  port: 22
  user: "whoami"
  key_path: "/home/whoami/.ssh/id_rsa"

backup:
  # Destination directory on OMV where backup archives will be stored
  local_dir: "/srv/dev-disk-by-uuid-4235dc09-7ffd-485c-a66c-c568d77ebf2a/nas_backup/servers_backup/omv-local"
  remote_temp_dir: "/tmp"
  retention_days: 7
  log_file: "/var/log/backup-mayster/backup-mayster-omv.log"
  sftp_max_retries: 3
  sftp_retry_delay: 5
  container_engine: "docker" # Using Docker on OMV
  server_name: "omv-local"   # Unique name to distinguish metrics in Prometheus

metrics:
  enabled: true
  stats_file: "/var/log/backup-mayster/backup-mayster-stats.json" # Exporter shares this file

discord:
  webhook_url: "https://discord.com/api/webhooks/YOUR_DISCORD_WEBHOOK_HERE"
  enabled: false

apps:
  # 1. OpenBao
  - name: "bao"
    path: "/docker-data/bao"
    pause_containers:
      - "bao"
    pre_backup_commands:
      # Copy compose file to data folder so they are archived together
      - "sudo cp /docker-compose/bao/docker-compose.yml /docker-data/bao/docker-compose.yml"
    post_backup_commands:
      - "sudo rm -f /docker-data/bao/docker-compose.yml"

  # 2. MinIO
  - name: "minio"
    path: "/docker-data/minio"
    pause_containers:
      - "minio"
    pre_backup_commands:
      - "cp /docker-compose/minio/docker-compose.yml /docker-data/minio/docker-compose.yml"
    post_backup_commands:
      - "rm -f /docker-data/minio/docker-compose.yml"

  # 3. Nginx Proxy Manager
  - name: "npm"
    path: "/docker-data/npm"
    pause_containers:
      - "nginx-proxy-manager"
    pre_backup_commands:
      - "cp /docker-compose/npm/docker-compose.yml /docker-data/npm/docker-compose.yml"
    post_backup_commands:
      - "rm -f /docker-data/npm/docker-compose.yml"

  # 4. Navidrome
  - name: "navidrome"
    path: "/docker-data/navidrome"
    pause_containers:
      - "navidrome"
    pre_backup_commands:
      - "cp /docker-compose/navidrome/docker-compose.yml /docker-data/navidrome/docker-compose.yml"
    post_backup_commands:
      - "rm -f /docker-data/navidrome/docker-compose.yml"

  # 5. Nextcloud
  - name: "nextcloud"
    path: "/docker-data/nextcloud"
    pause_containers:
      - "nextcloud"
      - "nextcloud-redis"
      # Pause MariaDB after dumping or keep it running to dump, then pause.
      # Since we dump db before pause, we keep it active.
    pre_backup_commands:
      # Step A: Dump Nextcloud Database to /tmp (since /docker-data/nextcloud is owned by www-data)
      - "docker exec nextcloud-mariadb sh -c 'exec mariadb-dump -uroot -p\"$MYSQL_ROOT_PASSWORD\" --all-databases' > /tmp/nextcloud_db_backup.sql"
      # Step B: Move it to the nextcloud data folder with sudo
      - "sudo mv /tmp/nextcloud_db_backup.sql /docker-data/nextcloud/nextcloud_db_backup.sql"
      # Step C: Copy compose file
      - "sudo cp /docker-compose/nextcloud/docker-compose.yml /docker-data/nextcloud/docker-compose.yml"
    post_backup_commands:
      - "sudo rm -f /docker-data/nextcloud/nextcloud_db_backup.sql"
      - "sudo rm -f /docker-data/nextcloud/docker-compose.yml"

  # 6. Monitoring - Prometheus Config & Data
  - name: "monitoring-prometheus"
    path: "/docker-data/prometheus"
    pause_containers:
      - "prometheus"
    pre_backup_commands:
      - "cp /docker-compose/monitoring/docker-compose.yml /docker-data/prometheus/docker-compose.yml"
    post_backup_commands:
      - "rm -f /docker-data/prometheus/docker-compose.yml"

  # 7. Monitoring - Grafana
  - name: "monitoring-grafana"
    path: "/docker-data/grafana"
    pause_containers:
      - "grafana"

  # 8. Monitoring - Loki
  - name: "monitoring-loki"
    path: "/docker-data/loki"
    pause_containers:
      - "loki"
